rules_version = '2';

// This app reaches Firestore exclusively through the Firebase Admin SDK
// (see lib/firebase.ts), which authenticates as a service account and
// bypasses these rules entirely. Nothing else should ever reach this
// database, so all direct client access is denied.
//
// Keeping this file in the repo means the rules are reviewable and
// versioned instead of living only in the Firebase Console, where a
// silently expiring test-mode rule took the app down on 2026-08-02.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
