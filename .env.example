# Copy to .env.local and fill in. Never commit real values.

# Firebase project id (Firebase Console > Project Settings).
FIREBASE_PROJECT_ID=your-project-id

# Firebase Admin SDK service account.
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# FIREBASE_PRIVATE_KEY stays on one line, double quoted, with literal \n escapes.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Signs the login session cookie. The app refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
